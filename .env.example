# TrustDesk environment. Copy to .env and fill in. NEVER commit .env.
# Only keys for providers you SELECT are required; startup fails with a clear list if one is missing.

# ---------------------------------------------------------------------------
# Server-only secrets and settings (AI service). Never expose to browsers.
# ---------------------------------------------------------------------------
TRUSTDESK_ENV=development            # development | test | production
TRUSTDESK_MODE=simple                # simple (one organization) | platform (many tenants)

# Runtime connection: MUST use the trustdesk_app role (RLS applies to it).
DATABASE_URL=postgresql://trustdesk_app:CHANGE_ME_APP_PASSWORD@localhost:5432/postgres
# Migration connection: schema owner (e.g. Supabase "postgres" user, direct port 5432, not the pooler).
DIRECT_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres
# Password `trustdesk db-bootstrap` sets for trustdesk_app (>=16 chars, [A-Za-z0-9_-]).
TRUSTDESK_APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD

# Fernet key for tenant secrets stored in the DB. Required in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRUSTDESK_ENCRYPTION_KEY=
# Required to create the first owner account in the Setup Wizard.
TRUSTDESK_SETUP_TOKEN=

# Providers. Profiles: local (default, zero API cost) | cloud | hybrid (mix per component).
LLM_PROVIDER=ollama                  # ollama | openai | anthropic | openai_compat
LLM_MODEL=llama3.1:8b
LLM_REASONING_EFFORT=                # none|low|medium|high for thinking models (Gemini: none)
EMBEDDING_PROVIDER=ollama            # ollama | local | openai | cohere
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024             # 384 | 768 | 1024 | 1536 (must match the model)
RERANKER_PROVIDER=local              # local | cohere | none
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=                     # only for openai_compat (Groq, Together, vLLM, LM Studio)
ANTHROPIC_API_KEY=
COHERE_API_KEY=

EMAIL_PROVIDER=console               # console (dev: logs only) | smtp | resend
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

CAPTCHA_PROVIDER=none                # none | turnstile | hcaptcha
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=                  # public site key (shown to browsers)
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

STORAGE_PROVIDER=local               # local | s3
STORAGE_LOCAL_DIR=./data/uploads

RATE_LIMIT_STORE=postgres            # postgres | redis
REDIS_URL=

# Observability (optional). Personal data is scrubbed before tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Admin dashboard origin(s) allowed to call admin endpoints (comma-separated, no "*").
# Widget origins are configured per organization in the admin Settings page.
ALLOWED_ORIGINS=http://localhost:3100
MONTHLY_SPEND_LIMIT=0                # USD across all tenants; 0 = no global cap
MAX_ANSWER_TOKENS=600
CONFIDENCE_THRESHOLD=0.35

# Handoff defaults (per-organization values in Settings override these).
WHATSAPP_NUMBER=
CALCOM_BOOKING_URL=

# ---------------------------------------------------------------------------
# Admin app (Next.js). NEXT_PUBLIC_* values are visible in the browser — no secrets there.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3100
AI_SERVICE_URL=http://localhost:8000          # server-side only
WIDGET_CDN_URL=http://localhost:5173
